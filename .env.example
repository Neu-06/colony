# Host publico
SERVER_IP=TU_IP_PUBLICA

# MongoDB
DB_NAME=colony_db
DB_USER=colony_admin
DB_PASS=REEMPLAZAR_CON_PASSWORD_SEGURO
MONGO_PORT=27017

# Spring Boot
SERVER_PORT=8080
SPRING_DATA_MONGODB_URI=mongodb://${DB_USER}:${DB_PASS}@mongodb:27017/${DB_NAME}?authSource=admin
SECURITY_JWT_SECRET=REEMPLAZAR_CON_UNA_CLAVE_BASE64_SEGURA
SECURITY_JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://${SERVER_IP}
APP_AI_RECOMMEND_URL=http://colony_ai:8000/api/v1/recommend
APP_AI_FIX_URL=http://colony_ai:8000/api/v1/fix

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_ALLOWED_ORIGINS=http://${SERVER_IP}
GROQ_API_KEY=REEMPLAZAR_CON_TU_API_KEY
GEMINI_API_KEY=REEMPLAZAR_CON_TU_API_KEY

# Angular / build-time
WEB_BACKEND_BASE_URL=http://${SERVER_IP}:8080
WEB_AI_BASE_URL=http://${SERVER_IP}:8000
WEB_WS_BASE_URL=ws://${SERVER_IP}:8080
WEB_FRONTEND_ORIGIN=http://${SERVER_IP}

# Docker Compose
WEB_PORT=80